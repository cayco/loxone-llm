# ==========================================================
# Loxone LLM Bridge - Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env
# ==========================================================

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model (e.g. gemini-3.6-flash, gemini-2.5-flash, or custom OpenAI-compatible model)
GEMINI_MODEL=gemini-3.6-flash

# Language for system instructions and TTS voice responses:
# "en" for English (default) or "pl" for Polish
LANGUAGE=en

# Port for OpenAI-compatible HTTP API (Home Assistant connects here)
PORT=8000

# MCP Server URL (running avrabe/mcp-loxone)
MCP_URL=http://127.0.0.1:3001/mcp

# Optional custom moods and ventilation mapping file
MOODS_CONFIG_FILE=moods.json

# Loxone Miniserver Connection Details
LOXONE_HOST=192.168.1.100
LOXONE_USER=your_loxone_username
LOXONE_PASS=your_loxone_password_here
